{
  "prefix": "DA",
  "docs": "docs",
  "cli": "npx --no-install backslop",
  "gates": [
    "npx --no-install backslop lint",
    "bun run lint",
    "bun run typecheck",
    "bun run check:comments",
    "bun run test",
    "bun run test:bun",
    "bun run test:ui",
    "bun run perf"
  ],
  "probe": "npm run probe",
  "version": "0.20.0",
  "source": "https://github.com/Velklish/backslop.git",
  "lang": "en",
  "tools": [
    "claude",
    "cursor",
    "codex"
  ],
  "hooks": [
    "claude"
  ]
}
