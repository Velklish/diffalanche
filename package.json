{
  "name": "diffalanche",
  "version": "0.0.0",
  "description": "A local code-review tool for a folder that holds many independent git repositories",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Velklish/diffalanche.git"
  },
  "type": "module",
  "bin": {
    "diffalanche": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun run scripts/build.ts",
    "test": "vitest run",
    "test:bun": "DIFFALANCHE_TEST_RUNTIME=bun bunx --bun vitest run",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/ui/tsconfig.json && tsc -p tsconfig.tools.json",
    "synth": "bun run scripts/synth.ts",
    "build:ui": "vite build",
    "build:cli": "bun build src/cli/index.ts --target node --outfile dist/cli.js",
    "perf": "bun perf/gate.ts",
    "test:ui": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@hono/node-server": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gitdiff-parser": "^0.3.1",
    "hono": "^4.13.7",
    "react": "^19.2.8",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.2.8",
    "refractor": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  }
}
